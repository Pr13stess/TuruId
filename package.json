{
  "name": "kosku",
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace=@kosku/user-app",
    "android": "npm run android --workspace=@kosku/user-app",
    "ios": "npm run ios --workspace=@kosku/user-app",
    "web": "npm run web --workspace=@kosku/user-app",
    "typecheck": "npm run typecheck --workspace=@kosku/user-app",
    "lint": "npm run lint --workspace=@kosku/user-app",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check:supabase": "node scripts/check-supabase.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tsx": "^4.23.15",
    "@types/react": "~19.3.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "react-dom": "19.3.0",
    "expo-font": "~58.0.12",
    "@expo/log-box": "58.0.15",
    "@expo/dom-webview": "58.0.2"
  }
}
