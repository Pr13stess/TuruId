{
  "expo": {
    "name": "Turu.Id",
    "slug": "kosku",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/turuid-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mikrofon untuk panggilan suara dengan pemilik kos."
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.kosku.demo.user"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.kosku.demo.user"
    },
    "web": {
      "favicon": "./assets/turuid-logo.png"
    },
    "scheme": "kosku",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Mikrofon untuk panggilan suara dengan pemilik kos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Turu.Id memakai lokasimu hanya untuk menghitung jarak ke kos. Lokasi tidak disimpan."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "314287a8-2c48-4391-a38b-e56a1c17699f"
      }
    },
    "owner": "pr13stess"
  }
}
